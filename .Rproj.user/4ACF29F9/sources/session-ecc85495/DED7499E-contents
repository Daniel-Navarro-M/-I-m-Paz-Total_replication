## Violence outcomes coefficient plot ----

# Combine all by-outcome models into one tidy data frame:
# - one row per (model spec, outcome, coefficient)
# - model_spec is the facet (OLS / Case FE / TWFE)
# - outcome drives the color (5 colors, one per violence type)

violence_plot_data <- dplyr::bind_rows(
  lapply(violence_types, function(v) {
    broom::tidy(violence_models_ols[[v]], conf.int = TRUE) |>
      dplyr::mutate(outcome = v, model_spec = "OLS")
  }),
  lapply(violence_types, function(v) {
    broom::tidy(violence_models_case_fe[[v]], conf.int = TRUE) |>
      dplyr::mutate(outcome = v, model_spec = "Case FE")
  }),
  lapply(violence_types, function(v) {
    broom::tidy(violence_models_twfe[[v]], conf.int = TRUE) |>
      dplyr::mutate(outcome = v, model_spec = "TWFE")
  })
) |>
  dplyr::filter(term %in% names(coef_map_violence)) |>
  dplyr::mutate(
    estimate    = as.numeric(estimate),
    conf.low    = as.numeric(conf.low),
    conf.high   = as.numeric(conf.high),
    term_label  = factor(
      unname(coef_map_violence[term]),
      levels = rev(unname(coef_map_violence))
    ),
    outcome     = factor(unname(violence_labels[outcome]),
                         levels = unname(violence_labels)),
    model_spec  = factor(model_spec, levels = c("OLS", "Case FE", "TWFE")),
    sig         = factor(
      sig_level(p.value),
      levels = c("p < 0.01", "p < 0.05", "p < 0.10", "n.s.")
    )
  ) |>
  dplyr::filter(is.finite(estimate), is.finite(conf.low), is.finite(conf.high))

p_violence <- ggplot(
  violence_plot_data,
  aes(x = term_label, y = estimate, color = outcome)
) +
  geom_hline(yintercept = 0, color = "black", linetype = "dashed") +
  geom_pointrange(
    aes(ymin = conf.low, ymax = conf.high, alpha = sig),
    position = position_dodge(width = 0.6),
    size = 0.5
  ) +
  scale_alpha_manual(
    name   = "Significance",
    values = c("p < 0.01" = 1, "p < 0.05" = 0.75, "p < 0.10" = 0.5, "n.s." = 0.25),
    drop   = FALSE
  ) +
  scale_color_brewer(name = "Outcome", palette = "Dark2") +
  scale_x_discrete("") +
  ylab("Estimate") +
  coord_flip() +
