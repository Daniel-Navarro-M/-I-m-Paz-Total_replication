# ---------- Claude Code state ----------
.claude/

# ---------- R / RStudio ----------
# Workspace state at the project root only — NOT .RData files inside data/
/.RData
/.RDataTmp
.Rhistory
.Rapp.history
.Ruserdata
*-Ex.R
/*.Rcheck/
.Rproj.user/

# knitr / R Markdown / Quarto intermediates
*_cache/
/cache/
*.utf8.md
*.knit.md
/.quarto/
*_files/

# renv (only relevant if you adopt renv later; harmless otherwise)
renv/library/
renv/local/
renv/cellar/
renv/python/
renv/staging/

# ---------- LaTeX build artifacts ----------
# Your scripts write .tex tables that SHOULD be tracked — only intermediates here.
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.synctex(busy)
*.fls
*.fdb_latexmk
*.bbl
*.blg
# Temp wrapper produced by scripts/4_5_github_tables.R
table_wrapper*

# ---------- Python (kept from your original .gitignore) ----------
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

